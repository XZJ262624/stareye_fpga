# set_clock_latency -source -hold <pll_clk_latency_clk_sys_min + 1.183> [get_ports {clk_54m}]

# set_clock_latency -source -setup <board_max + 2.039> [get_ports {cmos_pclk}]

# set_clock_latency -source -hold <board_min + 1.182> [get_ports {cmos_pclk}]



# M2 clock-domain budgets. CMOS 100 MHz is inherited timing budget, not measured PCLK.

set_max_delay -from [get_clocks {core_clk}] -to [get_clocks {clk_sys}] 4.5

set_max_delay -from [get_clocks {clk_sys}] -to [get_clocks {core_clk}] 4.5



# sys/core/DDR share PLL reference: 10.416=2*5.208=4*2.604 ns.

# Conservative common precision avoids false 1 ps relationships from independent rounding.



# M3.1: asynchronous keys only to the first synchronizer D pin.

set key0_meta_d [get_pins -regexp {^u_controls/key_meta\[0\]~FF\|D$}]

set key1_meta_d [get_pins -regexp {^u_controls/key_meta\[1\]~FF\|D$}]

if {[llength $key0_meta_d] != 1 || [llength $key1_meta_d] != 1} {error "M31 first-stage pin match is not exactly one per key"}

set_false_path -from [get_ports {key_n[0]}] -to $key0_meta_d

set_false_path -from [get_ports {key_n[1]}] -to $key1_meta_d

puts "M31_KEY_EXCEPTION_PINS $key0_meta_d $key1_meta_d"



# M5B1 explicit CDC endpoints. Generated by scripts/m5b1_constraints.py.

# Only exact named first-stage CDC endpoints and reset-release SR pins are cut.

# Gray and stable-mailbox paths have 5ns register-launch-to-D setup budgets.

# Efinity names the launch point CLK. Final detailed reports additionally audit

# clock-to-Q plus physical data delay and skew < one fastest 10ns source tick.

proc m5b1_exact {selectors label} {

 set result {}

 foreach selector $selectors {

  set one [get_pins -regexp $selector]

  if {[llength $one] != 1} {error "M5B1 exact CDC selector $label / $selector did not resolve once"}

  set result [concat $result $one]

 }

 puts "M5B1_CDC_PINS $label [llength $result] $result"

 return $result

}

set m5b1_video_camera_fifo_rgs1_source [m5b1_exact {

